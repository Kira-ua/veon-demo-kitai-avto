---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Catalog from "../components/Catalog.astro";
import Products from "../components/Products.astro";
import Request from "../components/Request.astro";
import Delivery from "../components/Delivery.astro";
import Repair from "../components/Repair.astro";
import Contacts from "../components/Contacts.astro";
import Footer from "../components/Footer.astro";
import StickyCall from "../components/StickyCall.astro";
import { phones, email, geo } from "../data/site";

const title = "Запчастини до китайських авто в Кременчуці — Китай авто";
const description = "Оригінал і аналоги для Chery, Geely, Great Wall, BYD та ще 9 марок. Магазин на Великій Набережній, 41а, доставка по всій Україні.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AutoPartsStore",
  name: "Китай авто",
  description,
  address: { "@type": "PostalAddress", streetAddress: "вул. Велика Набережна, 41а", addressLocality: "Кременчук", addressCountry: "UA" },
  geo: { "@type": "GeoCoordinates", latitude: geo.lat, longitude: geo.lng },
  telephone: phones.map((p) => p.href.replace("tel:", "")),
  email,
  openingHours: "Mo-Fr 10:00-18:00",
  areaServed: "UA",
};
---
<Base lang="uk" title={title} description={description} rec="U-R007,P-R002,P-R004,P-R006,P-R010,P-R011">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Header slot="header" />
  <Hero />
  <Catalog />
  <Products />
  <Request />
  <Delivery />
  <Repair />
  <Contacts />
  <Fragment slot="footer">
    <Footer />
    <StickyCall />
  </Fragment>
  <script src="../scripts/nav.ts"></script>
</Base>
