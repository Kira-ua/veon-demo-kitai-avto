---
// Final stop of every scenario: all four numbers large, e-mail, address, schedule, map link (no iframe, P-R003).
import { phones, email, address, hours, mapUrl } from "../data/site";
---
<section id="contacts" class="contacts" data-rec="U-R012,P-R003" aria-labelledby="contacts-title">
  <div class="container contacts__grid">
    <h2 id="contacts-title" class="section-title contacts__title">Контакти</h2>
    <ul class="phones" aria-label="Телефони магазину">
      {phones.map((p) => <li><a class="phones__link num" href={p.href}>{p.display}<span class="visually-hidden">;</span></a></li>)}
    </ul>
    <div class="place">
      <div class="place__block">
        <h3 class="place__title">Магазин</h3>
        <p>{address.city},<br />{address.street}</p>
      </div>
      <div class="place__block">
        <h3 class="place__title">Графік</h3>
        <p>{hours.full}<br />{hours.weekend}</p>
      </div>
      <div class="place__block">
        <h3 class="place__title">Пошта</h3>
        <p><a class="text-link place__mail" href={`mailto:${email}`}>{email}</a></p>
      </div>
      <a class="btn btn--outline place__map" href={mapUrl} target="_blank" rel="noopener noreferrer">Відкрити на карті<span class="visually-hidden"> (Google Карти, нова вкладка)</span></a>
    </div>
  </div>
</section>

<style>
  .contacts { padding-block: var(--section-gap-wide); }
  .contacts__grid { display: grid; gap: var(--space-6); }
  .phones { display: grid; border-top: var(--hairline) solid var(--color-text); }
  .phones li { border-bottom: var(--hairline) solid var(--color-line); }
  .phones__link {
    display: flex; align-items: center; min-height: 3.5rem; padding: var(--space-2) 0;
    font: 800 var(--text-brand-2)/1.1 var(--font-display); letter-spacing: -.02em; text-decoration: none; white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-out);
  }
  .phones__link:hover { color: var(--color-field); }
  .place { display: grid; gap: var(--space-5); align-content: start; }
  .place__block { display: grid; gap: var(--space-1); }
  .place__title { font: 600 var(--text-small)/1.4 var(--font-body); letter-spacing: 0; color: var(--color-muted); }
  .place__block p { font-size: var(--text-lead); line-height: 1.45; }
  .place__mail { overflow-wrap: anywhere; }
  .place__map { justify-self: start; }

  @media (min-width: 64rem) {
    .contacts__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-5); row-gap: var(--space-7); }
    .contacts__title { grid-column: 1 / -1; }
    .phones { grid-column: 1 / span 6; }
    .place { grid-column: 8 / span 5; }
  }
</style>
