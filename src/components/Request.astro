---
// «Як запитати деталь»: what to say on the phone instead of a VIN form (no fake send, demo.md §6).
import CallButton from "./CallButton.astro";
import { mainPhone, secondPhone, hours, email } from "../data/site";
const steps = [
  { title: "Марка, модель і рік авто", text: "Наприклад, Geely CK2 або Great Wall Hover H2." },
  { title: "VIN-код, якщо він під рукою", text: "Він є в техпаспорті. Менеджер скаже, чи потрібен він для вашої деталі." },
  { title: "Назва або код деталі", text: "Наприклад, кронштейн троса КПП з кодом S11-1703215." },
];
---
<section id="request" class="request on-field" data-rec="U-R004" aria-labelledby="request-title">
  <div class="container request__grid">
    <div class="request__main">
      <h2 id="request-title" class="section-title">Як запитати деталь</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step">
            <span class="step__num num" aria-hidden="true">{i + 1}</span>
            <div class="step__body">
              <h3 class="step__title">{s.title}</h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
    <div class="request__call">
      <CallButton phone={mainPhone} variant="lime" size="lg" />
      <CallButton phone={secondPhone} variant="outline-light" size="lg" />
      <p class="request__hours">{hours.full}, {hours.weekend.toLowerCase()}.</p>
      <p class="request__mail">Якщо зачинено, напишіть:<br /><a class="text-link" href={`mailto:${email}`}>{email}</a></p>
    </div>
  </div>
</section>

<style>
  .request { padding-block: var(--section-gap); }
  .request__grid { display: grid; gap: var(--space-8); }
  .steps { display: grid; gap: var(--space-5); padding-top: var(--space-6); counter-reset: none; }
  .step { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: var(--space-4); padding-top: var(--space-5); border-top: var(--hairline) solid var(--color-on-field-soft); }
  .step__num { font: 800 var(--text-section)/1 var(--font-display); color: var(--color-accent); }
  .step__body { display: grid; gap: var(--space-2); }
  .step__title { font-size: var(--text-title); line-height: 1.15; letter-spacing: -.01em; }
  .step__text { color: var(--color-on-field-soft); max-width: 44ch; }
  .request__call { display: grid; gap: var(--space-3); align-content: start; }
  .request__call :global(.btn) { width: 100%; font-family: var(--font-display); font-weight: 800; font-size: var(--text-title); letter-spacing: -.01em; }
  .request__hours { padding-top: var(--space-3); }
  .request__mail { color: var(--color-on-field-soft); overflow-wrap: anywhere; }
  .request__mail a { color: var(--color-on-field); }

  @media (min-width: 64rem) {
    .request__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-5); }
    .request__main { grid-column: 1 / span 7; }
    .request__call { grid-column: 9 / span 4; padding-top: var(--space-2); }
    .step { grid-template-columns: 5rem minmax(0, 1fr); }
  }
</style>
