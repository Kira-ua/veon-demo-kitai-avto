---
import "@fontsource-variable/geologica/wght.css";
import "@fontsource-variable/onest/wght.css";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import displayFont from "@fontsource-variable/geologica/files/geologica-cyrillic-wght-normal.woff2?url";

interface Props { lang: string; title: string; description: string; canonical?: string; rec?: string; }
const { lang, title, description, canonical, rec } = Astro.props;
---
<!doctype html>
<html lang={lang} data-rec={rec}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}img/logo.webp`} type="image/webp" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" data-rec="SEO-R001,SEO-R002,SEO-R003,SEO-R004,SEO-R005"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>

<style is:global>
  /* Floor 34: no horizontal scroll at any width (also in global.css; repeated here for the page-level check). */
  html, body { overflow-x: clip; }
</style>
